# Server Port
PORT=5000

# MongoDB Atlas Connection URI
# Note: Ensure the database name is LogicalSystem as specified in requirements
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/LogicalSystem?retryWrites=true&w=majority

# Optional: Fallback to local MongoDB if Atlas connection string is not yet filled in
# MONGO_URI=mongodb://localhost:27017/LogicalSystem
